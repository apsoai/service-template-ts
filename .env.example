# Application Configuration
APP_PORT=3000                    # Port number for the application to listen on
APP_SITE=http://localhost       # Base URL for the application
APP_NAME=Apso Template         # Application name
ALLOWED_ORIGINS=localhost,localhost:3001  # Comma-separated list of allowed CORS origins

# Cookie Settings
COOKIE_HTTP_ONLY=false         # Whether the cookie is accessible only through HTTP
COOKIE_PATH=/local/auth/refresh_token  # Cookie path
COOKIE_DOMAIN=localhost        # Cookie domain
COOKIE_SAME_SITE=             # Cookie same-site policy (Strict, Lax, None)
COOKIE_SECURE=                # Whether the cookie requires HTTPS

# Logging
LOG_LEVEL=debug               # Logging level (debug, info, warn, error)

# Session Configuration
SESSION_KEY=aid               # Session key name
SESSION_SECRET=your-secret-here  # Session secret for encryption

# Database Configuration
# DATABASE_TYPE options: pglite, postgres, none
#   pglite  - Embedded database, zero setup (default for local dev)
#   postgres - External PostgreSQL (for teams, staging, production)
#   none    - No database (WebContainer preview mode)
DATABASE_TYPE=pglite
DATABASE_SYNC=true          # Enable database schema sync (development only)
DATABASE_LOGGING=all        # Database query logging level

# PostgreSQL connection (only needed when DATABASE_TYPE=postgres)
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_USERNAME=apso
# DATABASE_NAME=apso
# DATABASE_PASSWORD=password
# DATABASE_SCHEMA=apso

# Environment
ENV=local                   # Environment (local, development, staging, production)

# AWS Configuration
AWS_REGION=us-west-2       # AWS region for deployment

# Observability (OpenTelemetry) — disabled by default.
# When these are unset, tracing is a no-op: it never blocks startup and never
# phones home. Set OTEL_EXPORTER_OTLP_ENDPOINT to enable per-request traces
# (route, method, status, latency, DB queries, errors) exported over OTLP HTTP.
# OTEL_ENABLED=true                              # Force-enable/disable (overrides endpoint detection)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318  # OTLP HTTP collector (OTel Collector or Grafana Cloud)
# OTEL_SERVICE_NAME=my-api                       # service.name in traces (defaults to APP_NAME, then package name)